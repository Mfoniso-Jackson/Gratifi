NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Permanent tip records go on Base (8453), or Base Sepolia (84532) for testing. Moonbeam shut down in 2026.
CHAIN_ID=84532
# Optional: defaults to Base's public endpoint for CHAIN_ID. Use a provider (Alchemy, QuickNode, Coinbase) in production.
CHAIN_RPC_URL=
CHAIN_OPERATOR_PRIVATE_KEY=
GRATIFI_PROTOCOL_CONTRACT_ADDRESS=
# "batch" (default): one Merkle root an hour for every waiting tip. "single": one transaction per tip.
ANCHOR_MODE=batch
# Optional: OpenTimestamps calendars for the Bitcoin backup (comma-separated https URLs).
OTS_CALENDARS=
# Optional: verify the contract on Basescan after deploying.
ETHERSCAN_API_KEY=

# £2 minimum: below that the 20p card fee takes more than 10% of the tip.
MIN_TIP_AMOUNT_PENCE=200
MAX_TIP_AMOUNT_PENCE=50000

# Preview the app with in-memory sample data (no Supabase, Stripe or blockchain).
# Admin pages are open and payments are simulated. Never enable in production.
GRATIFI_DEMO_MODE=false

# Optional: Upstash Redis REST API. Shares the checkout rate limit across server instances,
# and shares demo-mode data so demo mode works on hosted previews such as Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Warn when the operator wallet drops below this much ETH (see /api/health/operator-wallet).
CHAIN_LOW_BALANCE=0.002

# Secret for scheduled jobs (Vercel Cron sends it as a Bearer token). Required for automatic anchoring retries.
CRON_SECRET=

# Sponsors and the Dream Fund stay off until legal sign-off. Demo mode shows them regardless.
GRATIFI_SPONSORS_ENABLED=false

# Days after the 30-day pilot before a venue without a plan stops taking new tips.
PILOT_GRACE_DAYS=7
